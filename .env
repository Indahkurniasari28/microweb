# =============================================
# MICROWAT Server Configuration
# =============================================

# Flask Motor Controller (Raspberry Pi)
# Ganti dengan IP RPi kamu (cek dengan: hostname -I di terminal RPi)
FLASK_URL=http://192.168.1.18:5000

# Web server port (di hosting biasanya diisi otomatis oleh platform)
PORT=3000

# Built-in MQTT broker lokal untuk perangkat di LAN
MQTT_PORT=1883
ENABLE_LOCAL_MQTT=true

# MQTT (opsional)
# MQTT_BROKER=wss://...
# MQTT_USER=pomclear
# MQTT_PASSWORD=Pomclear123
