# MICROWAT Server Configuration

# Raspberry Pi Flask motor controller URL (optional)
FLASK_URL=http://127.0.0.1:5000

# Web app HTTP port
PORT=3000

# Local built-in MQTT broker
MQTT_PORT=1883
ENABLE_LOCAL_MQTT=true

# Cloud MQTT fallback (optional)
# MQTT_BROKER=wss://your-broker-host:8884/mqtt
# MQTT_USER=your-username
# MQTT_PASSWORD=your-password
